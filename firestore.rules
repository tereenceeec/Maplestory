rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{itemId} {
      allow read: if true;

      allow create: if isValidItem(request.resource.data)
        && request.resource.data.previousSold == null
        && request.resource.data.previousSoldAt == null;

      allow update: if isValidItem(request.resource.data);

      allow delete: if false;
    }

    function isValidItem(data) {
      return data.keys().hasAll([
          'name',
          'iconUrl',
          'lastSold',
          'lastSoldAt',
          'previousSold',
          'previousSoldAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.iconUrl is string
        && data.iconUrl.size() > 0
        && data.iconUrl.size() <= 350000
        && data.lastSold is number
        && data.lastSold >= 0
        && data.lastSold <= 999999999999
        && (data.previousSold == null || (data.previousSold is number && data.previousSold >= 0))
        && (data.previousSoldAt == null || data.previousSoldAt is timestamp)
        && data.lastSoldAt is timestamp
        && data.updatedAt is timestamp;
    }
  }
}
